# ===================================================================
# SMART ATTENDANCE AND PREDICTOR SYSTEM - ENVIRONMENT CONFIGURATION
# ===================================================================

# -------------------------------------------------------------------
# 1. BACKEND ENVIRONMENT VARIABLES (Configure in Render.com)
# -------------------------------------------------------------------
NODE_ENV=production
PORT=5000

# MongoDB Atlas Connection String
# Obtain from MongoDB Atlas -> Database -> Connect -> Drivers
# Format: mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/attendance_predictor?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<your_username>:<your_password>@cluster0.xxxx.mongodb.net/attendance_predictor?retryWrites=true&w=majority

# JWT Authentication Secret Key (Generate a random 32+ character string)
JWT_SECRET=your_jwt_secret_key_attendance_predictor_production_2026

# Optional: Set your Netlify frontend URL to restrict CORS in production
# If omitted, CORS will permit all trusted client origins including *.netlify.app
FRONTEND_URL=https://your-app-name.netlify.app

# -------------------------------------------------------------------
# 2. FRONTEND ENVIRONMENT VARIABLES (Configure in Netlify Dashboard)
# -------------------------------------------------------------------
# Set this in Netlify -> Site configuration -> Environment variables
# pointing to your deployed Render backend web service URL (NO trailing slash):
VITE_API_URL=https://your-backend-name.onrender.com
